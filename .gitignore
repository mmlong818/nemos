# Build artifacts
node_modules/
dist/
*.tgz
bin/
obj/
.vs/
.cache/
tmp/
.tmp/
output/

# Vendored 第三方引擎的编译产物需要入库：运行时（tsx）直接引用 dist，
# 主项目的严格检查靠它的声明文件，不入库则一份干净检出跑不起来。
# 用通配覆盖所有引擎——只写死一个的话，新增引擎会重复踩同一个坑。
!sdk/typescript/examples/companion/vendor/*/dist/

# Local packaged desktop client artifacts
sdk/typescript/examples/companion/client/dist/
sdk/typescript/examples/companion/client/vendor/
sdk/typescript/examples/companion/client/**/*.user

# Local secrets and private runtime settings
.env
.env.*
*.dpapi.json
*.key
*.pem
*.p12
*.pfx

# SQLite runtime files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 陪伴 App 运行时状态（含用户实际数据，不入 git）
sdk/typescript/companion-rel.json
sdk/typescript/companion-personas.json
sdk/typescript/companion-familiarity.json
sdk/typescript/companion-groups.json
sdk/typescript/companion-capabilities.json
sdk/typescript/companion-tasks.json
sdk/typescript/companion-tool-settings.json

# IDE / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log

# Coverage
coverage/
.nyc_output/
