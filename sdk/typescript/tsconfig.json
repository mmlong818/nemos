{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    // 显式固定环境类型面。改为消费外部 @nemos/sdk 之后，隐式 @types 引入不再生效
    // （同一份 tsconfig 在 nemos-memory 里仍正常，差别只是那边不引外部包；
    // 具体机制未查明）。显式声明本身也更可靠：不依赖 node_modules/@types 里恰好有什么。
    "types": ["node", "better-sqlite3"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "examples"]
}

