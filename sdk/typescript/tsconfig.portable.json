{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".client-build/compiled",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": false
  },
  "include": [
    "src/**/*.ts",
    "examples/companion/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".client-build",
    "examples/companion/client",
    "examples/companion/docs",
    "examples/companion/vendor",
    "examples/companion/web/editor-engines"
  ]
}
