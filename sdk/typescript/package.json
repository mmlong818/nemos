{
  "name": "@nemos/sdk",
  "version": "0.7.5-alpha.17",
  "description": "Application-agnostic, local-first memory engine for AI systems with provenance, temporal facts, lifecycle reconciliation, and controllable recall.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "nemos founding team",
  "homepage": "https://github.com/mmlong818/nemos",
  "repository": {
    "type": "git",
    "url": "https://github.com/mmlong818/nemos.git",
    "directory": "sdk/typescript"
  },
  "keywords": [
    "memory",
    "ai",
    "agent",
    "llm",
    "embedding",
    "rag",
    "personal-memory",
    "nemos"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "companion": "tsx examples/companion/server.ts",
    "companion:cli": "tsx examples/companion/chat-cli.ts",
    "build": "tsc",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts tests/v02/unit/*.test.ts tests/v02/integration/*.test.ts tests/v03/unit/*.test.ts tests/v03/integration/*.test.ts tests/v04/unit/*.test.ts tests/v04/integration/*.test.ts tests/v05/unit/*.test.ts tests/v05/integration/*.test.ts tests/v06/integration/*.test.ts tests/v07/integration/*.test.ts",
    "test:unit": "tsx --test tests/unit/*.test.ts tests/v02/unit/*.test.ts tests/v03/unit/*.test.ts tests/v04/unit/*.test.ts tests/v05/unit/*.test.ts",
    "test:v02": "tsx --test tests/v02/unit/*.test.ts tests/v02/integration/*.test.ts",
    "test:v03": "tsx --test tests/v03/unit/*.test.ts tests/v03/integration/*.test.ts",
    "test:v04": "tsx --test tests/v04/unit/*.test.ts tests/v04/integration/*.test.ts",
    "test:v05": "tsx --test tests/v05/unit/*.test.ts tests/v05/integration/*.test.ts",
    "test:v06": "tsx --test tests/v06/integration/*.test.ts",
    "test:v07": "tsx --test tests/v07/integration/*.test.ts",
    "prepublishOnly": "npm run build",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "better-sqlite3": "^12.10.0",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^5.4.624",
    "pdfkit": "^0.17.2",
    "pptxgenjs": "^4.0.1",
    "typebox": "^1.1.4"
  },
  "optionalDependencies": {
    "sqlite-vec": "^0.1.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "*",
    "openai": "*"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.10.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "engines": {
    "node": ">=22.19"
  },
  "private": true
}
